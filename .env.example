# Copy to .env and adjust. Every value is optional.

# Data scope used by setup.py: minimal | balanced | full
FTM_DATA_SCOPE=balanced

# Where raw/processed data and ML artifacts live (default: backend/data)
# FTM_DATA_DIR=/absolute/path/to/data

# API bind address
FTM_API_HOST=127.0.0.1
FTM_API_PORT=8000

# Parallel downloads from raw.githubusercontent.com (be polite)
FTM_DOWNLOAD_WORKERS=8
